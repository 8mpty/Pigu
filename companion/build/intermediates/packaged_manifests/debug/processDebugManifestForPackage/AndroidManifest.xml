<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="moe.shizuku.privileged.api"
    android:versionCode="1365"
    android:versionName="13.7.0" >

    <uses-sdk
        android:minSdkVersion="24"
        android:targetSdkVersion="37" />

    <queries>
        <package android:name="com.empty.pigu" />
    </queries>

    <application
        android:allowBackup="false"
        android:debuggable="true"
        android:extractNativeLibs="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true" >
        <receiver
            android:name="com.empty.pigu.companion.BinderRequestReceiver"
            android:exported="true" >
            <intent-filter>
                <action android:name="rikka.shizuku.intent.action.REQUEST_BINDER" />
            </intent-filter>
        </receiver>
    </application>

</manifest>