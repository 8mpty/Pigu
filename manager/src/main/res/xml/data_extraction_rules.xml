<?xml version="1.0" encoding="utf-8"?>
<data-extraction-rules>
    <cloud-backup>
        <include
            domain="sharedpref"
            path="settings.xml" />
        <!-- Only settings.xml is included. The automation token lives in secrets.xml, which is
             deliberately not listed here and therefore not backed up. -->
    </cloud-backup>
    <device-transfer>
        <include
            domain="sharedpref"
            path="settings.xml" />
    </device-transfer>
</data-extraction-rules>
